[Unit]
Description=가계부 웹 대시보드
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# 배포 경로는 봇(budget_bot.service)과 동일한 /root/Household_accounts 로 통일.
# /root 는 0700 이라 전용 계정으로는 접근 불가하므로 root 로 실행한다.
User=root
WorkingDirectory=/root/Household_accounts/dashboard
EnvironmentFile=/root/Household_accounts/.env
ExecStart=/root/Household_accounts/dashboard/venv/bin/uvicorn app:app --host 0.0.0.0 --port 8081
Restart=on-failure
RestartSec=10
StandardOutput=journal
StandardError=journal
SyslogIdentifier=budget_dashboard

# 보안 hardening (budget_bot.service와 동일 수준)
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ReadWritePaths=/root/Household_accounts

# 리소스 제한
MemoryMax=256M
CPUQuota=30%

[Install]
WantedBy=multi-user.target
