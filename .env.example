# ── 텔레그램 봇 ────────────────────────────────────────────────────
# @BotFather 에서 /newbot 으로 발급
BUDGET_BOT_TOKEN=bot_token_here

# 관리자(본인) 텔레그램 유저 ID
# 확인: @userinfobot 에서 /start 를 누르면 표시됨
ADMIN_USER_ID=your_telegram_user_id_here

# ── Google Sheets ───────────────────────────────────────────────────
# URL: https://docs.google.com/spreadsheets/d/{SPREADSHEET_ID}/edit
SPREADSHEET_ID=your_spreadsheet_id_here

# Google Service Account JSON 파일 경로 (기본값: credentials.json)
GOOGLE_CREDS_PATH=credentials.json

# ── 웹 대시보드 ─────────────────────────────────────────────────────
# 대시보드 접속 비밀번호 (아이디는 없습니다 — 반드시 강력하게 설정)
DASHBOARD_PASS=strong_password_here

# 대시보드 포트 (기본값: 8081)
# 주의: 운영 서버의 8080 은 다른 서비스가 사용 중입니다.
#       systemd 유닛(dashboard.service)이 --port 로 명시하므로 그쪽이 우선합니다.
DASHBOARD_PORT=8081

# 대시보드 URL (봇 기록 후 캐시 자동 초기화용, 미설정 시 비활성)
# 예: http://localhost:8081 또는 http://your-server-ip:8081
DASHBOARD_URL=
