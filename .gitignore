# 환경변수 (API 키 포함 - 절대 커밋 금지)
.env

# Google Service Account 인증 파일 (개인키 포함 - 절대 커밋 금지)
credentials.json
*.json.key
token.json

# Python
__pycache__/
*.py[cod]
*.pyo
*.egg-info/
dist/
build/
.eggs/

# 가상환경
venv/
.venv/
env/

# 로그 / 런타임 데이터
*.log
*.db
*.sqlite

# 대시보드
dashboard/venv/
dashboard/__pycache__/
dashboard/*.pyc

# matplotlib 캐시 (ProtectSystem=strict 하에서 쓰기 가능한 경로)
.mplcache/

# 편집 중 백업본 (배포 경로에 쌓이지 않도록)
*.bak
*.bak[0-9]
*.presec

# OS
.DS_Store
Thumbs.db

# 커버리지 리포트
.coverage
htmlcov/
